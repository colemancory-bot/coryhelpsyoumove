# Large media files (host on CDN separately)
*.mp4
*.mov
*.avi
*.mkv

# Environment / secrets
.env
.env.*

# Supabase local config (secrets handled via Supabase CLI env vars)
supabase/.env
supabase/.temp/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / tools
.vscode/
.idea/
.claude/
*.swp
*.swo

# Build scripts (not needed in production)
_generate-pages.js

# Generated CMA + presentation artifacts (regenerate from source)
/CMA-*.pdf
/cma-report-*.html
/doc.html
/generate-pdf.mjs
/images/cma/
marketing/*.pptx
marketing/*-print.pdf

# Node (if added later)
node_modules/

# Backtest raw output (regenerate from scripts/cma-backtest.mjs)
scripts/output/
